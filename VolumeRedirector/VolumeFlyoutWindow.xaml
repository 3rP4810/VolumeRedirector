<Window x:Class="VolumeRedirector.VolumeFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume Redirector"
        Width="348" Height="92"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Margin = ShadowMargin nel code-behind: lascia spazio all'ombra -->
    <Border x:Name="Card" Margin="14" CornerRadius="8" BorderThickness="1" Padding="16,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.30"/>
        </Border.Effect>

        <!-- Come la flyout di sistema: altoparlante, barra sottile, valore.
             In più, a sinistra: icona dell'app scelta con il nome sotto. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Icona dell'app con il nome sotto -->
            <StackPanel Width="80" VerticalAlignment="Center">
                <Grid Width="24" Height="24" HorizontalAlignment="Center">
                    <Image x:Name="AppIconImage" Width="24" Height="24"/>
                    <TextBlock x:Name="AppIconFallback" Text="&#xE71D;" FontSize="20"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="NameText" Margin="0,3,0,0" FontSize="12"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Altoparlante (cambia con il livello; barrato se muta) -->
            <TextBlock x:Name="SpeakerIcon" Width="20" Margin="12,0,0,0" FontSize="16"
                       TextAlignment="Center" VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>

            <!-- Barra sottile con estremi arrotondati -->
            <Grid Width="110" Height="4" Margin="14,0" VerticalAlignment="Center">
                <Border x:Name="BarTrack" CornerRadius="2"/>
                <Border x:Name="BarFill" CornerRadius="2" HorizontalAlignment="Left"/>
            </Grid>

            <!-- Valore, senza il simbolo % come in Windows -->
            <TextBlock x:Name="ValueText" Width="30" FontSize="16" FontWeight="Light"
                       TextAlignment="Right" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
